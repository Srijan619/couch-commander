<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CouchCommander" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The player cuts in and out with no window animation: a video surface fading with its window flashes black. -->
    <style name="Theme.CouchCommander.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
