<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes only from the stock TV launchers (see HomeButtonService). No key filtering. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:description="@string/home_button_description"
    android:notificationTimeout="0"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher" />
